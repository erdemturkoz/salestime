{
  "manifest_version": 3,
  "name": "SalesTime WhatsApp Gönderici",
  "description": "SalesTime teklif kuyruğunu güvenli biçimde WhatsApp Web üzerinden gönderir.",
  "version": "1.0.1",
  "key": "",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://salestime.onrender.com/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "SalesTime WhatsApp Gönderici",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp-content.js"],
      "run_at": "document_idle"
    }
  ]
}
